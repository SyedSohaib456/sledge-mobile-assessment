{
  "expo": {
    "name": "FieldCapture",
    "slug": "sledge-mobile-assessment",
    "scheme": "fieldcapture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sledge.fieldcapture"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1923"
      },
      "package": "com.sledge.fieldcapture"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FieldCapture needs access to your photo library to attach images to captures."
        }
      ]
    ]
  }
}
